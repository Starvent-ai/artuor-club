{
  "name": "@arthurclub/desktop-app",
  "version": "0.1.0",
  "private": true,
  "main": "dist/desktop-app/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "copy:migrations": "node scripts/copyMigrations.js",
    "build": "npm run build:renderer && npm run build:main && npm run copy:migrations",
    "start": "electron dist/desktop-app/main/index.js",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "better-sqlite3": "11.5.0"
  },
  "devDependencies": {
    "electron": "32.1.2",
    "electron-builder": "25.1.8",
    "vite": "5.4.9",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1"
  },
  "build": {
    "appId": "ir.starvent.arthurclub",
    "productName": "ArthurClub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "artifactName": "Artuor-clab.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
